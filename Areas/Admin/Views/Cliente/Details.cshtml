@model Barber.UI.Entities.DTO.ClientDTO


<div class="container my-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Detalhes do Cliente</h2>
        </div>
        <div class="card-body">
            
            <div class="row mb-3">
                <div class="col-sm-4 font-weight-bold">Código do Cliente:</div>
                <div class="col-sm-8">@Html.DisplayFor(model => model.Id)</div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-4 font-weight-bold">Nome do Cliente:</div>
                <div class="col-sm-8">@Html.DisplayFor(model => model.Name)</div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-4 font-weight-bold">Ultima vez aqui:</div>
                <div class="col-sm-8">@Html.DisplayFor(model => model.LastTimeHere)</div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-4 font-weight-bold">Agendado:</div>
                <div class="col-sm-8">@Html.DisplayFor(model => model.Scheduled)</div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-4 font-weight-bold">Email:</div>
                <div class="col-sm-8">@Html.DisplayFor(model => model.Email)</div>
            </div>
        </div>
        <div class="card-footer text-end">
            <a asp-area="Admin" asp-controller="Cliente" asp-action="Manager" class="btn btn-secondary">Voltar</a>
        </div>
    </div>
</div>