<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Barber.UI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/StyleSheet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Barber.UI.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Muli:wght@300;400;600;700&display=swap" rel="stylesheet">


    <style>
        /* Ensure the body and html take up full height */
        html, body {
            height: 100%;
            margin: 0;
        }

        /* Set up a flex container for the entire page */
        .page-wrapper {
            display: flex;
            flex-direction: column;
            min-height: 100vh; /* Full viewport height */
        }

        /* Ensure main content takes up all available space */
        .content {
            flex: 1;
        }
    </style>
</head>
<body>
    <div class="page-wrapper">
        <header>
            <nav class="navbar navbar-expand-lg navbar border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <!-- Branding -->
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="title">BARBER SHOP</span>
                    </a>

                    <!-- Toggler for mobile view -->
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <!-- Navbar links and partials -->
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <!-- Centered Navbar Links -->
                        <ul class="navbar-nav mx-auto">
                            <li class="nav-item d-flex flex-column align-items-center">
                                <img src="~/Images/casa.png" width="25px" alt="Home Icon" />
                                <a class="nav-link mt-1" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light d-flex flex-column align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="~/Images/gerente.png" width="25px" alt="Gerenciamento" class="mb-1" />
                                    Gerenciamento
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Schedule" asp-action="Index">Gerenciar Agenda</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Cliente" asp-action="Add">Adicionar Cliente</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Cliente" asp-action="Manager">Gerenciar Clientes</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="BarberAdmin" asp-action="Add">Adicionar Barbeiro</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="BarberAdmin" asp-action="Barbers">Gerenciar Barbeiros</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
        <div class="container content">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
