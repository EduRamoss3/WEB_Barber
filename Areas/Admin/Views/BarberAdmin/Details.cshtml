@model Barber.UI.Entities.DTO.BarberDTO

@{
    ViewData["Title"] = "Detalhes do Barbeiro";
}

<div class="container mt-5">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white text-center">
            <h2>Detalhes do Barbeiro</h2>
        </div>
        <div class="card-body">
            <div class="text-center mb-4">
                <img src="~/Images/do-utilizador.png" class="rounded-circle" alt="@Model.Name" width="150" height="150">
                <h3 class="mt-3">@Model.Name</h3>
                @if (Model.Disponibility)
                {
                    <p class="text-muted">Disponível</p>

                }
                else
                {
                    <p class="text-muted">Indisponível</p>
                }
            </div>
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Nome</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Disponibilidade</dt>
                @if (Model.Disponibility)
                {
                   <dd class="col-sm-9">Disponível</dd>
                }
                else
                {
                   <dd class="col-sm-9">Indisponível</dd>
                }
            </dl>
        </div>
        <div class="card-footer text-center">
            <a asp-area="Admin" asp-action="Edit" asp-route-idBarber="@Model.Id" class="btn btn-warning">Editar</a>
            <a asp-area="Admin" asp-controller="BarberAdmin" asp-action="DeleteInformation" asp-route-id="@Model.Id" class="btn btn-secondary">Excluir</a>
            <a asp-action="Barbers" class="btn btn-secondary">Voltar</a>
        </div>
    </div>
</div>
