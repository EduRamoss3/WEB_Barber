@using Barber.UI.Entities.Register
@model BarberRegisterDTO

<div class="container mt-4 text-dark">
    <h2 class="text-black fw-bold">Registro de Barbeiro</h2>
    <form asp-area="Admin" asp-controller="BarberAdmin" asp-action="Add" method="post" class="needs-validation" novalidate>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Registrar</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

