@using Barber.UI.Entities
@model List<SchedulesDTO>

@{
    ViewData["Title"] = "Cliente pelo ID";
}

<div class="container mt-4">
    @if (Model.Count == 0)
    {
        <h1 class="text-center text-danger">@TempData["Erro"]</h1>
    }
    else
    {
        <h2 class="text-center text-info">Agendamentos do Cliente</h2>
        <table class="table table-striped table-hover table-responsive-md bg-light mt-4">
            <thead class="table-dark">
                <tr>
                    <th>ID Cliente</th>
                    <th>ID Agendamento</th>
                    <th>ID Barbeiro</th>
                    <th>Serviço</th>
                    <th>Data e Hora</th>
                    <th>Finalizado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdClient</td>
                        <td>@item.Id</td>
                        <td>@item.IdBarber</td>
                        <td>@item.TypeOfService</td>
                        <td>@item.DateSchedule.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (item.IsFinalized)
                            {
                                <span class="badge bg-success">Sim</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Não</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
