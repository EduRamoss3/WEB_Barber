@using Barber.UI.Entities.DTO
@model List<SchedulesDTO>

@{
    ViewData["Title"] = "Agenda";
}

<div class="container mt-4">
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success text-center" role="alert">
            @TempData["Success"]
        </div>
    }

    <div class="row">
        <div class="col-md-3">
            <aside class="bg-light p-3 rounded shadow-sm">
                <h5 class="text-center">Ações</h5>
                <div class="list-group">
                    <a class="list-group-item list-group-item-action d-flex align-items-center" asp-area="Admin" asp-controller="Schedule" asp-action="Search">
                        <img src="~/Images/lupa.png" width="20px" alt="Lupa" class="me-2" />
                        Pesquisar
                    </a>
                    <a class="list-group-item list-group-item-action d-flex align-items-center" asp-area="Admin" asp-controller="Schedule" asp-action="Delete">
                        <img src="~/Images/lixeira.png" width="20px" alt="Lixeira" class="me-2" />
                        Deletar
                    </a>
                    <a class="list-group-item list-group-item-action d-flex align-items-center" asp-area="Admin" asp-controller="Schedule" asp-action="Add">
                        <img src="~/Images/adicionar.png" width="20px" alt="+" class="me-2" />
                        Adicionar
                    </a>
                </div>
            </aside>
        </div>

        <div class="col-md-9">
            @if (Model is not null)
            {
                @if (Model.Count == 0)
                {
                    <div class="alert alert-info text-center" role="alert">
                        Sem agendamentos!
                    </div>
                }
                else
                {
                    <div class="accordion" id="accordionSchedule">
                        @foreach (var item in Model.OrderBy(x => x.DateSchedule))
                        {
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="heading-@item.Id">
                                    <button class="accordion-button collapsed shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@item.Id" aria-expanded="false" aria-controls="collapse-@item.Id">
                                        @item.DateSchedule.ToString("dddd, dd MMMM yyyy") ás @item.DateSchedule.ToString("HH:mm")
                                    </button>
                                </h2>
                                <div id="collapse-@item.Id" class="accordion-collapse collapse" aria-labelledby="heading-@item.Id" data-bs-parent="#accordionSchedule">
                                    <div class="accordion-body">
                                        <h5 class="card-title">@item.DateSchedule.ToString("HH:mm") - @item.ClientName</h5>
                                        <p class="card-text">
                                            <strong>Barbeiro:</strong> @item.BarberName <br>
                                            <strong>Serviço:</strong> @item.TypeOfService <br>
                                            <strong>Valor:</strong> @item.ValueForService.ToString("C") <br>
                                            <strong>Finalizado:</strong> @(item.IsFinalized ? "Sim" : "Não") <br>
                                        </p>
                                        <div class="d-flex justify-content-between">
                                            <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-idSchedule="@item.Id">Editar</a>
                                            <a class="btn btn-sm btn-info" asp-action="Details" asp-route-idSchedule="@item.Id">Detalhes</a>
                                            <a class="btn btn-sm btn-danger" asp-action="DeleteInformation" asp-route-id="@item.Id">Deletar</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="alert alert-danger text-center" role="alert">
                    Erro, faça o login e tente novamente.
                </div>
            }
        </div>
    </div>

    <!-- Botões na parte inferior centralizada -->
    <div class="row mt-4 groupbtn">
        <div class="col text-center">
            <div class="btn-toolbar justify-content-center" role="toolbar" aria-label="Toolbar with button groups">
                <div class="btn-group me-2" role="group" aria-label="First group">
                    <button type="button" class="btn btn-primary">1</button>
                    <button type="button" class="btn btn-primary">2</button>
                    <button type="button" class="btn btn-primary">3</button>
                    <button type="button" class="btn btn-primary">4</button>
                </div>
                <div class="btn-group me-2" role="group" aria-label="Second group">
                    <button type="button" class="btn btn-secondary">5</button>
                    <button type="button" class="btn btn-secondary">6</button>
                    <button type="button" class="btn btn-secondary">7</button>
                </div>
                <div class="btn-group" role="group" aria-label="Third group">
                    <button type="button" class="btn btn-info">8</button>
                </div>
            </div>
        </div>
    </div>
</div>
