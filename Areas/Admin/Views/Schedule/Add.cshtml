@model Barber.UI.Entities.SchedulesDTO

@{
    ViewData["Title"] = "Adicionar Agendamento";
}

<div class="container mt-5">
    <h2>@ViewData["Title"]</h2>
    <form asp-controller="Schedule" asp-action="Add" method="post">
        <div class="mb-3">
            <label asp-for="IdBarber" class="form-label"></label>
            <input asp-for="IdBarber" class="form-control" placeholder="Digite o ID do barbeiro" />
            <span asp-validation-for="IdBarber" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IdClient" class="form-label"></label>
            <input asp-for="IdClient" class="form-control" placeholder="Digite o ID do cliente" />
            <span asp-validation-for="IdClient" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="TypeOfService" class="form-label"></label>
            <select asp-for="TypeOfService" class="form-select">
                <option value="1">Normal</option>
                <option value="2">Gradient</option>
                <option value="3">Gradient and Beard</option>
                <option value="4">Beard</option>
                <option value="5">Coloring</option>
                <option value="6">Coloring Only Beard and Normal</option>
                <option value="7">Coloring All and Gradient</option>
                <option value="8">Coloring All and Normal</option>
                <option value="9">Coloring Only Beard and Gradient</option>
                <option value="10">Only Wash</option>
                <option value="11">Wax</option>
            </select>
            <span asp-validation-for="TypeOfService" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DateSchedule" class="form-label"></label>
            <input asp-for="DateSchedule" class="form-control" type="datetime-local" />
            <span asp-validation-for="DateSchedule" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ValueForService" class="form-label"></label>
            <input asp-for="ValueForService" class="form-control" placeholder="Digite o valor do serviço" />
            <span asp-validation-for="ValueForService" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsFinalized" class="form-check-input" type="checkbox" />
            <label asp-for="IsFinalized" class="form-check-label"></label>
        </div>
        <button type="submit" class="btn btn-primary">Salvar Agendamento</button>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
