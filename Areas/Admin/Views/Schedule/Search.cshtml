@{
    ViewData["Title"] = "Pesquise";
}

<form class="form-horizontal" asp-controller="Schedule" asp-action="GetByClientId" method="get">
    <div class="mb-3">
        <label class="form-label text-light" for="clientId">Identificador do cliente</label>
        <input class="form-control  w-25 border-1" type="number" min="1" name="clientId" id="clientId" />
    </div>
    <div class="btn-group">
        <button class="btn btn-success" type="submit">Search</button>
    </div>
</form>