@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">
    <!-- Hero Section -->
    <div class="row align-items-center">
        <div class="col-md-6 text-center text-md-start">
            <h1 class="display-4 fw-bold">Bem-vindo à Barbearia Estilo</h1>
            <p class="lead mt-4">Onde tradição e modernidade se encontram para oferecer a melhor experiência em cuidados masculinos.</p>
            <a href="@Url.Action("BookAppointment", "Schedule")" class="btn btn-lg mt-3">Agende seu horário</a>
        </div>
        <div class="col-md-6 text-center">
            <img class="w-50" src="~/Images/iconebarbacom.png" alt="Barbearia Estilo" class="img-fluid rounded shadow-lg">
        </div>
    </div>

    <!-- About Section -->
    <div class="row mt-5 bg-wood">
        <div class="col-md-12 text-center">
            <h2 class="fw-bold">Sobre Nós</h2>
            <p class="lead mt-3">A Barbearia Estilo é mais do que apenas um corte de cabelo. Somos um espaço onde você pode relaxar, se cuidar e sair sentindo-se renovado. Oferecemos uma variedade de serviços, desde o tradicional corte de cabelo até barba, coloração e tratamentos capilares.</p>
        </div>
    </div>

    <!-- Services Section -->
    <div class="row mt-5">
        <div class="col-md-12 text-center">
            <h2 class="fw-bold">Nossos Serviços</h2>
        </div>
        <div class="col-lg-4 col-md-6 mt-4">
            <div class="card h-100 border-0 shadow">
                <img src="~/Images/barber_hero.png" class="card-img-top" alt="Corte de Cabelo" style="object-fit: cover; height: 250px;">
                <div class="card-body">
                    <h5 class="card-title">Corte de Cabelo</h5>
                    <p class="card-text">Experimente o melhor corte de cabelo, feito pelos nossos profissionais altamente qualificados.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 mt-4">
            <div class="card h-100 border-0 shadow">
                <img src="~/Images/barba1.png" class="card-img-top" alt="Barba" style="object-fit: cover; height: 250px;">
                <div class="card-body">
                    <h5 class="card-title">Barba</h5>
                    <p class="card-text">Desde o alinhamento até o estilo completo, deixe sua barba impecável.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 mt-4">
            <div class="card h-100 border-0 shadow">
                <img src="~/Images/cabeloplatinado.jpg" class="card-img-top" alt="Coloração" style="object-fit: cover; height: 250px;">
                <div class="card-body">
                    <h5 class="card-title">Coloração</h5>
                    <p class="card-text">Atualize seu visual com nossas opções de coloração e tratamentos capilares.</p>
                </div>
            </div>
        </div>
    </div>


    <!-- Testimonials Section -->
    <div class="row mt-5">
        <div class="col-md-12 text-center">
            <h2 class="fw-bold">Depoimentos</h2>
            <p class="lead mt-3">Veja o que nossos clientes têm a dizer:</p>
        </div>
        <div class="col-md-4 mt-4">
            <blockquote class="blockquote text-center">
                <p class="mb-0">"A melhor barbearia da cidade! Sempre saio satisfeito com o atendimento e o corte."</p>
                <footer class="blockquote-footer mt-1">João Silva</footer>
            </blockquote>
        </div>
        <div class="col-md-4 mt-4">
            <blockquote class="blockquote text-center">
                <p class="mb-0">"Serviço de primeira qualidade, recomendo a todos meus amigos."</p>
                <footer class="blockquote-footer mt-1">Carlos Oliveira</footer>
            </blockquote>
        </div>
        <div class="col-md-4 mt-4">
            <blockquote class="blockquote text-center">
                <p class="mb-0">"Ambiente agradável e profissionais qualificados. Adorei a experiência!"</p>
                <footer class="blockquote-footer mt-1">Marcos Santos</footer>
            </blockquote>
        </div>
    </div>

    <!-- Call to Action -->
    <div class="row mt-5">
        <div class="col-md-12 text-center">
            <h2 class="fw-bold">Agende Agora</h2>
            <p class="lead mt-3">Garanta seu horário e tenha a melhor experiência em nossa barbearia.</p>
            <a href="@Url.Action("BookAppointment", "Schedule")" class="btn btn-lg btn-outline-primary">Agendar Horário</a>
        </div>
    </div>
</div>
