@{
    ViewData["Title"] = "Barber Shopger";
}
<style>
    #barberCarousel .carousel-item img {
        height: 400px; /* Defina a altura fixa desejada */
        object-fit: cover; /* Faz com que a imagem cubra o contêiner sem distorcer */
    }
</style>
<div class="container mt-5">
    <!-- Hero Section -->
    <div class="row align-items-center">
        <div class="col-md-6 text-center text-md-start">
            <h1 class="display-4 fw-bold">Bem-vindo à Barber Shopger</h1>
            <p class="lead mt-4">Onde tradição e modernidade se encontram para oferecer a melhor experiência em cuidados masculinos.</p>
            <a asp-controller="ScheduleClient" asp-action="SelectBarber" class="btn btn-primary">Agende seu horário</a>
        </div>
        <div class="col-md-6 text-center">
            <img class="w-50" src="~/Images/barbericon2.png" alt="Barbearia Estilo" class="img-fluid rounded shadow-lg">
        </div>
    </div>

    <!-- About Section -->
    <div class="row mt-5 bg-wood">
        <div class="col-md-12 text-center">
            <h2 class="fw-bold">Sobre Nós</h2>
            <p class="lead mt-3">A Barber Shopger é mais do que apenas um corte de cabelo. Somos um espaço onde você pode relaxar, se cuidar e sair sentindo-se renovado. Oferecemos uma variedade de serviços, desde o tradicional corte de cabelo até barba, coloração e tratamentos capilares.</p>
        </div>
    </div>

    <!-- Carousel Section -->
    <div id="barberCarousel" class="carousel slide mt-5">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/Images/pngtree.jpg" class="d-block w-100" alt="Imagem 1">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Ambiente Agradável</h5>
                    <p>Desfrute de um ambiente acolhedor e sofisticado.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/Images/barbearia1.jpg" class="d-block w-100" alt="Imagem 2">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Mais de 20 Barbearias</h5>
                    <p>Faça parte da maior barbearia do Brasil, marque seu horário.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/Images/background.jpg" class="d-block w-100" alt="Imagem 3">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Equipamento moderno</h5>
                    <p>Tenha o melhor tratamento com diversos equipamentos modernos e sofisticados</p>
                </div>
            </div>
        </div>
        <a class="carousel-control-prev" href="#barberCarousel" role="button" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </a>
        <a class="carousel-control-next" href="#barberCarousel" role="button" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </a>
    </div>


    <!-- Services Section -->
    <div class="row mt-5">
        <div class="col-md-12 text-center">
            <h2 class="fw-bold">Nossos Serviços</h2>
        </div>
        <div class="col-lg-4 col-md-6 mt-4">
            <div class="card h-100 border-0 shadow" style="border-radius: 50px;">
                <img src="~/Images/penteado1.png" class="card-img-top" alt="Corte de Cabelo" style="object-fit: contain; height: 250px;">
                <div class="card-body">
                    <h5 class="card-title">Corte de Cabelo</h5>
                    <p class="card-text">Experimente o melhor corte de cabelo, feito pelos nossos profissionais altamente qualificados.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 mt-4">
            <div class="card h-100 border-0 shadow" style="border-radius: 50px;">
                <img src="~/Images/barbaicon.png" class="card-img-top" alt="Barba" style="object-fit: contain; height: 250px;">
                <div class="card-body" style="border-radius: 120px;">
                    <h5 class="card-title">Barba</h5>
                    <p class="card-text">Desde o alinhamento até o estilo completo, deixe sua barba impecável.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 mt-4">
            <div class="card h-100 border-0 shadow" style="border-radius: 50px;">
                <img src="~/Images/penteado.png" class="card-img-top" alt="Coloração" style="object-fit: contain; height: 250px;">
                <div class="card-body">
                    <h5 class="card-title">Coloração</h5>
                    <p class="card-text">Atualize seu visual com nossas opções de coloração e tratamentos capilares.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Testimonials Section -->
    <div class="container mt-5">
        <div class="row text-center mb-5">
            <div class="col-md-12">
                <h2 class="fw-bold mb-3">Depoimentos</h2>
                <p class="lead">Veja o que nossos clientes têm a dizer:</p>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm border-light">
                    <div class="card-body">
                        <blockquote class="blockquote mb-0">
                            <p>"A melhor barbearia da cidade! Sempre saio satisfeito com o atendimento e o corte."</p>
                            <footer class="blockquote-footer">João Silva</footer>
                        </blockquote>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm border-light">
                    <div class="card-body">
                        <blockquote class="blockquote mb-0">
                            <p>"Serviço de primeira qualidade, recomendo a todos meus amigos."</p>
                            <footer class="blockquote-footer">Carlos Oliveira</footer>
                        </blockquote>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm border-light">
                    <div class="card-body">
                        <blockquote class="blockquote mb-0">
                            <p>"Ambiente agradável e profissionais qualificados. Adorei a experiência!"</p>
                            <footer class="blockquote-footer">Marcos Santos</footer>
                        </blockquote>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Call to Action -->
    <div class="row mt-5">
        <div class="col-md-12 text-center">
            <h2 class="fw-bold">Agende Agora</h2>
            <p class="lead mt-3">Garanta seu horário e tenha a melhor experiência em nossa barbearia.</p>
            <a asp-controller="ScheduleClient" asp-action="SelectBarber" class="btn btn-lg btn-primary">Agendar Horário</a>
        </div>
    </div>
</div>
