@{
    ViewData["Title"] = "Deleção";
}

<form class="form-horizontal" asp-controller="Schedule" asp-action="Delete" method="post">
    <div class="mb-3">
        <label class="form-label text-info" for="id">Identificador do agendamento</label>
        <input class="form-control w-25" type="number" min="1" name="id" id="id" />
    </div>
    <div class="btn-group">
        <input type="submit" class="btn btn-success" />
    </div>
</form>
