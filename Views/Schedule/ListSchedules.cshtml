@using Barber.UI.Entities
@model List<SchedulesDTO>;

@if(Model.Count == 0)
{
    <h1>Sem agendamentos!</h1>
}
else
{
    <table class="table table-responsive-md bg-light">
        @foreach (var schedule in Model)
        {
            <div class="d-table-row">
                <div class="d-table-cell">@schedule.IdClient</div>
            </div>

        }
    </table>
   
}
