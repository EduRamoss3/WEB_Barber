@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Login";
    var session = HttpContextAccessor.HttpContext.Session.GetString("Logged");  
}

@if(session is not null)
{
    @if (session.Equals("false"))
    {
        <li class="nav-item">
            <a class="nav-link text-light" asp-controller="Account" asp-action="Register">Registre-se</a>
        </li>
    }
}
else if(session is null)
{
    <li class="nav-item">
        <a class="nav-link text-light" asp-controller="Account" asp-action="Register">Registre-se</a>
    </li>
}




