<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Barbearia</title>
    <link rel="icon" href="~/Images/dsd.png" type="image/x-icon" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Barber.UI.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap">

</head>
<body>
    @inject Microsoft.AspNetCore.Http.IHttpContextAccessor _httpContextAccessor

    <header>
        <nav class="navbar navbar-expand-lg navbar border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <!-- Wrapper with Bootstrap container for centralization -->
                <div class="container">
                    <!-- Navbar principal layout com flex -->
                    <div class="d-flex justify-content-between align-items-center">
                        <!-- Branding -->
                        <a class="navbar-brand text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                            <span class="title">BARBER SHOPGER</span>
                        </a>

                        <!-- Centralized Navbar Links -->
                        <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                            <ul class="navbar-nav">
                                <li class="nav-item d-flex flex-column align-items-center">
                                    <a class="nav-link mt-1 d-flex flex-column align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                                        <img src="~/Images/casa.png" width="25px" alt="Home Icon" />
                                        Home
                                    </a>
                                </li>
                                <li class="nav-item d-flex flex-column align-items-center">
                                    <a class="nav-link mt-1 d-flex flex-column align-items-center" asp-area="" asp-controller="Home" asp-action="Sobre">
                                        <img src="~/Images/sobre.png" width="25px" alt="Sobre Icon" />
                                        Sobre
                                    </a>
                                </li>
                                <li class="nav-item d-flex flex-column align-items-center">
                                    <a class="nav-link mt-1 d-flex flex-column align-items-center" asp-area="" asp-controller="Home" asp-action="Contato">
                                        <img src="~/Images/contato.png" width="25px" alt="Contato Icon" />
                                        Contato
                                    </a>
                                </li>
                                <li class="nav-item d-flex flex-column align-items-center">
                                    <a class="nav-link mt-1 d-flex flex-column align-items-center" asp-area="" asp-controller="Home" asp-action="Mais">
                                        <img src="~/Images/mais.png" width="25px" alt="Mais Icon" />
                                        Mais
                                    </a>
                                </li>
                                @if (_httpContextAccessor.HttpContext.Session.GetString("Role") is not null)
                                {
                                    @if (_httpContextAccessor.HttpContext.Session.GetString("Role").Equals("Admin"))
                                    {
                                        <li class="nav-item d-flex flex-column align-items-center">
                                            <a class="nav-link mt-1 d-flex flex-column align-items-center" asp-area="Admin" asp-controller="Schedule" asp-action="Index">
                                                <img src="~/Images/engrenagem.png" width="25px" alt="Admin Icon" />
                                                Área Admin
                                            </a>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>

                        <!-- Partials for login/register -->
                        <div class="d-flex align-items-center">
                            @await Html.PartialAsync("_LoginPartial")
                            @await Html.PartialAsync("_RegisterPartial")
                        </div>
                    </div>
                </div> <!-- End of container -->
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - Barber.UI - Eduardo Ramos
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
