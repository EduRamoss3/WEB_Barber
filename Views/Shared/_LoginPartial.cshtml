@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Login";
    var session = HttpContextAccessor.HttpContext.Session.GetString("Logged");
    bool parsed = false;
    if (session is not null)
    {
        parsed = bool.Parse(session);
    }
}

@if (parsed)
{
    <p class="nav-link text-primary fw-bolder">Seja bem-vindo!</p>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
    </li>
}
