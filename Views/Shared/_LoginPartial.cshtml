@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Login";
    var session = HttpContextAccessor.HttpContext.Session.GetString("Logged");
}
<style>
    .no-marker {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .nav-item {
        list-style: none;
    }
</style>
@if(session is not null)
{
    @if (session.Equals("true"))
    {

        <li class="nav-item text-light">
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="nav-link btn btn-link text-light p-0">Logout</button>
            </form>
        </li>
       
    } 
}
else
{
    <li class="nav-item">
        <a class="nav-link text-light" asp-controller="Account" asp-action="Login">Login</a>
    </li>
}

