@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Login";
    var session = HttpContextAccessor.HttpContext.Session.GetString("Logged");
}
<style>
    .no-marker {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .nav-item {
        list-style: none;
    }
</style>
@if (session is not null)
{
    @if (session.Equals("true"))
    {
        <li class="nav-item d-flex flex-column align-items-center">
            <img src="~/Images/do-utilizador.png" width="25px" alt="User Icon" style="margin-bottom: 2px;" />
            <form class="nav-link text-light" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-link text-light p-0">Logout</button>
            </form>
        </li>
        <li class="nav-item d-flex flex-column align-items-center">
            <img src="~/Images/agendar.png" width="25px" alt="Schedule Icon" />
            <a class="nav-link text-light mt-1" asp-controller="ScheduleClient" asp-action="MySchedules">Meus Agendamentos</a>
        </li>
    }
}
else
{
    <li class="nav-item">
        <a class="nav-link text-light" asp-controller="Account" asp-action="Login">Login</a>
    </li>
}

