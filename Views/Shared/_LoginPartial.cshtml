@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Login";
    var session = HttpContextAccessor.HttpContext.Session.GetString("Logged");
    bool parsed = false;
    if (session is not null)
    {
        parsed = bool.Parse(session);
    }
}
<style>
    .no-marker {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .nav-item {
        list-style: none;
    }
</style>
@if (parsed)
{

    <li class="nav-item text-light text-decoration-none no-marker">Seja bem-vindo!</li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-light"  asp-controller="Account" asp-action="Login">Login</a>
    </li>
}
